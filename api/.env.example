# --- App ---
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# --- Entra ID multi-tenant app registration ---
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=organizations
API_AUDIENCE=api://your-client-id
# Comma-separated allow-list; leave empty to accept every consenting tenant.
ALLOWED_TENANT_IDS=

# --- Data stores ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cloudinsight
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Azure Key Vault (per-connection secrets; never store secrets in the DB) ---
KEY_VAULT_URI=

# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
ASSISTANT_RATE_LIMIT_PER_HOUR=60

# --- Reports ---
REPORTS_STORAGE_ACCOUNT_URL=
REPORTS_CONTAINER=reports
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@cloudinsight.local
