{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    // Official Stitch MCP. Credential is stored outside the repository.
    // Restart OpenCode after configuration changes. Never paste a key here.
    // https://stitch.withgoogle.com/docs/mcp/setup
    "stitch": {
      "type": "remote",
      "url": "https://stitch.googleapis.com/mcp",
      "headers": { "X-Goog-Api-Key": "{file:~/.config/opencode/secrets/stitch-api-key}" },
      "enabled": true
    },
    // Optional Figma desktop Dev Mode server; independent of Stitch.
    "figma": {
      "type": "remote",
      "url": "http://127.0.0.1:3845/mcp",
      "enabled": false
    }
  }
}
