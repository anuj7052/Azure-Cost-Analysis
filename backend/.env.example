# Azure AD App Registration
AZURE_CLIENT_ID=your-azure-ad-app-client-id
AZURE_CLIENT_SECRET=your-azure-ad-app-client-secret
AZURE_TENANT_ID=your-primary-tenant-id

# JWT Validation
# Leave AZURE_TENANT_ID as-is. Token validation uses Azure AD JWKS endpoint.

# App Settings
APP_SECRET_KEY=change-this-to-a-random-secret-key-at-least-32-chars
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite DB path (relative to backend dir)
DB_PATH=./data/azure_cost.db
