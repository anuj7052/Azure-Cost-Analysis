# ─────────────────────────────────────────────────────────────────────────────
# Azure Control & Intelligence Platform — backend configuration
#
# Copy to `.env` and fill in. Never commit the result: `.env` is gitignored,
# `.env.example` is not, and this file must therefore contain no real values.
# ─────────────────────────────────────────────────────────────────────────────

# development | staging | production
#
# Setting this to `production` turns on strict startup checks. The app refuses
# to boot if the signing key is still the default, the client id is missing, or
# any CORS origin is plain http. That refusal is deliberate: an insecure
# production deployment otherwise looks like it is working perfectly.
ENVIRONMENT=development


# ── Azure AD app registration ────────────────────────────────────────────────

AZURE_CLIENT_ID=your-azure-ad-app-client-id
AZURE_CLIENT_SECRET=your-azure-ad-app-client-secret
AZURE_TENANT_ID=your-primary-tenant-id

# Token validation uses the Azure AD JWKS endpoint and needs no extra config.
#
# In production only tokens issued for AZURE_CLIENT_ID are accepted. In
# development, ARM-scoped tokens are accepted too so the frontend can reuse the
# token it already holds for Azure calls. That relaxation is development only —
# accepting ARM tokens in production would let a token minted for any other
# consented application be replayed against this API.


# ── Application ──────────────────────────────────────────────────────────────

# Must be at least 32 characters in production, and must not be left as the
# shipped default. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=change-this-to-a-random-secret-key-at-least-32-chars

# Comma separated. Must all be https in production.
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# SQLite path, relative to the backend directory.
# Development only — production targets PostgreSQL (roadmap Stage 1).
DB_PATH=./data/azure_cost.db


# ── Platform administrators ──────────────────────────────────────────────────

# Comma separated. Anyone listed here is promoted to admin on their next
# sign-in. Admin rights deliberately live outside the database so they cannot be
# granted by anything the application itself exposes, only by whoever controls
# the deployment environment.
ADMIN_EMAILS=you@yourcompany.com,second.admin@yourcompany.com


# ── API protection ───────────────────────────────────────────────────────────

# Sliding window per caller. This protects the customer's Azure quota as much as
# this API: an uncontrolled client loop against a cost route burns the tenant's
# Cost Management allowance, and the resulting throttle lands on every other
# user of that tenant.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=240
RATE_LIMIT_WINDOW_SECONDS=60

# Send HSTS. Leave false for local http development, true behind TLS.
SECURITY_HEADERS_HSTS=false


# ── BOQ chat assistant (optional) ────────────────────────────────────────────

# Leave OPENAI_BASE_URL empty for api.openai.com, or point it at a gateway.
# Customers can also supply their own endpoint per account in Settings, which is
# preferred — a key set here is shared by every user of this deployment.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=1500

# Use the host's `az login` as a credential source, so no service principal
# and no pasted session token is needed for any tenant that CLI account can
# reach. Off by default and refused in production: the CLI identity belongs
# to whoever runs the process, not to whoever is calling the API.
AZURE_CLI_AUTH=false
